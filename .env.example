# Copy this file to .env and adjust values to your setup.
# .env is git-ignored and will never be committed.

# Global hotkey to show/hide the jrnl entry window.
# Uses pynput key syntax: https://pynput.readthedocs.io/en/latest/keyboard.html
# Default: <cmd>+j  (Windows key + J)
JRNL_HOTKEY=<cmd>+j
